# ──────────────────────────────────────────
#  BTCC Explorer — Environment Variables
#  Copy this file to .env and fill in values
# ──────────────────────────────────────────

# ── BTCC Public Explorer API ─────────────────────────────
EXPLORER_URL=https://explorer.bitcoin-classic.net
EXPLORER_TIMEOUT=60000
EXPLORER_MAX_RETRIES=5

# ── PostgreSQL ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=btcc_explorer
DB_USER=btcc
DB_PASSWORD=your_secure_db_password
DB_POOL_MAX=20

# ── Redis ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API Server ─────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# Cache TTLs (seconds)
CACHE_TTL=10
CACHE_TTL_LONG=300

# Rate limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=60000

# ── Indexer ────────────────────────────────
POLL_INTERVAL=5000
BATCH_SIZE=50
START_HEIGHT=0
CONCURRENCY=3

# ── Frontend ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ── Logging ────────────────────────────────
LOG_LEVEL=info
